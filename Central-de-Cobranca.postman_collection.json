        },
        {
          "name": "Consulta - Liveness UP",
          "request": { "method": "GET", "header": [], "url": "{{consultaUrl}}/q/health/live", "description": "Objetivo: validar liveness do consulta (C6). Esperado: 200 e status UP." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","pm.test('Health UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"]}}]
        },
        {
          "name": "Emissor - Readiness UP",
          "request": { "method": "GET", "header": [], "url": "{{emissorUrl}}/q/health/ready", "description": "Objetivo: validar readiness do emissor (C6). Esperado: 200 e status UP." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","pm.test('Health UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"]}}]
        },
        {
          "name": "Registro - Readiness UP",
          "request": { "method": "GET", "header": [], "url": "{{registroUrl}}/q/health/ready", "description": "Objetivo: validar readiness do registro (C6). Esperado: 200 e status UP." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","pm.test('Health UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"]}}]
        },
        {
          "name": "Consulta - Readiness UP",
          "request": { "method": "GET", "header": [], "url": "{{consultaUrl}}/q/health/ready", "description": "Objetivo: validar readiness do consulta (C6). Esperado: 200 e status UP." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","pm.test('Health UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"]}}]
        },
        {
          "name": "Emissor - Metrics contem metrica de negocio",
          "request": { "method": "GET", "header": [], "url": "{{emissorUrl}}/q/metrics", "description": "Objetivo: verificar metrica de negocio do emissor cobranca_boletos_emissao_solicitacoes_total (C6). Esperado: 200 e corpo contendo a metrica." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","const body = pm.response.text();","pm.test('Metrica de negocio presente', function () { pm.expect(body).to.include('cobranca_boletos_emissao_solicitacoes_total'); });"]}}]
        },
        {
          "name": "Registro - Metrics disponiveis",
          "request": { "method": "GET", "header": [], "url": "{{registroUrl}}/q/metrics", "description": "Objetivo: validar endpoint de metricas do registro (C6). Esperado: 200." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]}}]
        },
        {
          "name": "Consulta - Metrics disponiveis",
          "request": { "method": "GET", "header": [], "url": "{{consultaUrl}}/q/metrics", "description": "Objetivo: validar endpoint de metricas do consulta (C6). Esperado: 200." },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]}}]
        }
      ]
    },
    {
      "name": "02 - Emissor - Autenticacao e RBAC",
      "item": [
        {
          "name": "POST /boletos sem credencial -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"CTRL-SEM-CREDENCIAL\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: autenticao obrigatoria no emissor (C5). Esperado: 401 com desafio Basic."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 401', function () { pm.response.to.have.status(401); });","pm.test('WWW-Authenticate Basic', function () { pm.expect(pm.response.headers.get('WWW-Authenticate') || '').to.include('Basic'); });"]}}]
        },
        {
          "name": "POST /boletos operador senha errada -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "basic", "basic": [{"key":"username","value":"{{operadorUsuario}}","type":"string"},{"key":"password","value":"senha-errada","type":"string"}] },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"CTRL-SENHA-ERRADA\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: validar falha de credencial (C5). Esperado: 401."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 401', function () { pm.response.to.have.status(401); });"]}}]
        },
        {
          "name": "POST /boletos com auditor -> 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "basic", "basic": [{"key":"username","value":"{{auditorUsuario}}","type":"string"},{"key":"password","value":"{{auditorSenha}}","type":"string"}] },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"CTRL-AUDITOR-403\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: validar RBAC do emissor (C5). Esperado: 403."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 403', function () { pm.response.to.have.status(403); });","const ct = (pm.response.headers.get('Content-Type') || '').toLowerCase();","if (ct.includes('application/json')) {","  const json = pm.response.json();","  pm.test('Envelope 403 padrao', function () {","    pm.expect(json.status).to.eql(403);","    pm.expect(json.codigo).to.eql('FORBIDDEN');","  });","}"]}}]
        },
        {
          "name": "POST /boletos com operador -> 201",
          "event": [
            {"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('numeroControleCliente')) {","  pm.collectionVariables.set('numeroControleCliente', 'CTRL-' + Date.now());","}"]}},
            {"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201', function () { pm.response.to.have.status(201); });","const json = pm.response.json();","pm.test('Status negocio AGUARDANDO_REGISTRO', function () { pm.expect(json.status).to.eql('AGUARDANDO_REGISTRO'); });","pm.collectionVariables.set('boletoId', json.identificador);","const loc = pm.response.headers.get('Location');","pm.test('Header Location presente', function () { pm.expect(loc).to.be.a('string').and.not.empty; });"]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "basic", "basic": [{"key":"username","value":"{{operadorUsuario}}","type":"string"},{"key":"password","value":"{{operadorSenha}}","type":"string"}] },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"{{numeroControleCliente}}\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: operador autorizado consegue emitir (C1, C5, C7). Esperado: 201, Location e identificador capturado em boletoId."
          }
        }
      ]
    },
    {
      "name": "03 - Emissao - Fluxo Principal",
      "item": [
        {
          "name": "Emitir boleto (captura boletoId + valida Location)",
          "event": [
            {"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('numeroControleCliente', 'CTRL-FLUXO-' + Date.now());"]}},
            {"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201', function () { pm.response.to.have.status(201); });","const json = pm.response.json();","pm.test('Campos essenciais retornados', function () {","  pm.expect(json.identificador).to.be.a('string');","  pm.expect(json.convenio).to.eql('123456');","  pm.expect(json.numeroControleCliente).to.eql(pm.collectionVariables.get('numeroControleCliente'));","  pm.expect(json.valorNominal).to.eql(50);","  pm.expect(json.status).to.eql('AGUARDANDO_REGISTRO');","});","pm.collectionVariables.set('boletoId', json.identificador);","const loc = pm.response.headers.get('Location') || '';","pm.test('Location contem o boletoId', function () { pm.expect(loc).to.include('/boletos/' + json.identificador); });"]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "basic", "basic": [{"key":"username","value":"{{operadorUsuario}}","type":"string"},{"key":"password","value":"{{operadorSenha}}","type":"string"}] },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"{{numeroControleCliente}}\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: fluxo principal de emissao (C1, C2, C3, C7)."
          }
        },
        {
          "name": "Consultar interno no emissor por boletoId",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": "{{emissorUrl}}/interno/boletos/{{boletoId}}",
            "description": "Objetivo: validar persistencia/consulta local da emissao (C3). Esperado: 200 e identificador igual ao boletoId."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","const json = pm.response.json();","pm.test('Identificador confere', function () { pm.expect(json.identificador).to.eql(pm.collectionVariables.get('boletoId')); });"]}}]
        },
        {
          "name": "Repetir mesma chave (convenio+numeroControleCliente) -> 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "basic", "basic": [{"key":"username","value":"{{operadorUsuario}}","type":"string"},{"key":"password","value":"{{operadorSenha}}","type":"string"}] },
            "url": "{{emissorUrl}}/boletos",
            "body": { "mode": "raw", "raw": "{\n  \"convenio\": \"123456\",\n  \"numeroControleCliente\": \"{{numeroControleCliente}}\",\n  \"valorNominal\": 50.00\n}" },
            "description": "Objetivo: validar conflito por duplicidade (C2, C3). Esperado: 409 CONFLICT."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 409', function () { pm.response.to.have.status(409); });","const json = pm.response.json();","pm.test('Envelope de conflito', function () {","  pm.expect(json.status).to.eql(409);","  pm.expect(json.codigo).to.eql('CONFLICT');","});"]}}]
        }
      ]
    },
